# Скопируйте в .env и поправьте. Все строки необязательны, указаны значения по умолчанию.

# Папка на сервере, куда скачиваются файлы с Яндекс.Диска (структура папок сохраняется)
YDL_DOWNLOADS=./downloads

# Порт страницы управления: http://<адрес сервера>:8085
YDL_PORT=8085

# Пароль для входа на страницу. Пусто = вход без пароля (только для домашней сети!).
# ОБЯЗАТЕЛЬНО задайте, если сервер виден из интернета: на странице вводятся пароли от ваших ссылок.
# Сменить, сбросить или отключить позже: ./ydl password
YDL_PASSWORD=

# Слоты: сколько файлов скачивается одновременно (1–32). 8 подходит большинству.
# Медленный интернет (до ~50 Мбит/с): 4. Яндекс часто просит притормозить: 4. Быстрый канал (от 500 Мбит/с): 8–12.
# Подробнее в README, раздел «Слоты». Сменить позже: ./ydl slots 6
YDL_SLOTS=8

# Разведчик узлов: пока Яндекс сбоит, заранее узнаёт, на каких серверах Яндекса лежат ближайшие файлы,
# и ставит первыми те, что на здоровых. 0 = выключить.
YDL_SCOUT=1

# От чьего имени создаются файлы (узнать: команда id). Для обычного пользователя Linux обычно 1000.
PUID=1000
PGID=1000

# Часовой пояс для времени в журнале
TZ=Europe/Moscow

# HTTPS (шифрование). Обычно настраивается установщиком или командой ./ydl https ..., руками не нужно.
# off = без шифрования; ip = VPS, сертификат Let's Encrypt на IP; domain = на домен
YDL_HTTPS=off
# адрес для HTTPS (IP или домен)
YDL_HTTPS_HOST=

# Имена, под которыми вы открываете страницу (через запятую), если это не IP-адрес, не короткое имя и не *.local/*.lan.
# Защита от подмены адреса (DNS-rebinding): запросы с другим именем в заголовке Host отклоняются.
# Нужно, например, при доступе через Tailscale (машина.tailnet.ts.net) или своё имя через обратный прокси. Домен HTTPS добавляется сам.
YDL_ALLOWED_HOSTS=

# Минимум свободного места на диске загрузок, ГБ: меньше — загрузка приостанавливается сама (чтобы не забить диск).
YDL_MIN_FREE_GB=2
